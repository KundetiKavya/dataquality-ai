# DataQuality AI — Environment Variables
# Copy this file, rename it to .env, and fill in your values

# Anthropic API Key — get yours at https://console.anthropic.com
# IMPORTANT: For production, never expose this key in the frontend.
# Move the API call to a backend server (Node.js, Python, etc.)
REACT_APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App environment
REACT_APP_ENV=development

# Optional: your company name (shown in the app)
REACT_APP_COMPANY_NAME=Acme Corporation
